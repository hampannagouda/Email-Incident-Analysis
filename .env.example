# Copy to .env and fill in. Never commit the real .env.

# Claude API key (https://console.anthropic.com/) — used for AI analysis
ANTHROPIC_API_KEY=

# Azure AD app registration with Microsoft Graph Mail.Read application permission
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Microsoft Teams Workflows webhook URLs
# (Teams channel > Workflows > "Post to a channel when a webhook request is received")
TEAMS_WEBHOOK_DEFAULT=
TEAMS_WEBHOOK_MAJOR=
